# Recovery-specific view derived from the stock mt6991 fstab. AVB and product
# overlays are Android boot concerns and are intentionally not reproduced here.
system /system erofs ro wait,slotselect,logical
system /system ext4 ro wait,slotselect,logical
system_ext /system_ext erofs ro wait,slotselect,logical
system_ext /system_ext ext4 ro wait,slotselect,logical
vendor /vendor erofs ro wait,slotselect,logical
vendor /vendor ext4 ro wait,slotselect,logical
product /product erofs ro wait,slotselect,logical
product /product ext4 ro wait,slotselect,logical
odm /odm erofs ro wait,slotselect,logical
odm /odm ext4 ro wait,slotselect,logical
vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,logical
vendor_dlkm /vendor_dlkm ext4 ro wait,slotselect,logical
odm_dlkm /odm_dlkm erofs ro wait,slotselect,logical
odm_dlkm /odm_dlkm ext4 ro wait,slotselect,logical
system_dlkm /system_dlkm erofs ro wait,slotselect,logical
system_dlkm /system_dlkm ext4 ro wait,slotselect,logical
mi_ext /mi_ext erofs ro wait,slotselect,logical
mi_ext /mi_ext ext4 ro wait,slotselect,logical

/dev/block/by-name/metadata /metadata f2fs noatime,nosuid,nodev,discard wait,check
# Keep noatime: fscrypt_is_data_mounted_noatime() is the read-only decrypt guard.
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,gc_merge,atgc,age_extent_cache,inlinecrypt wait,check,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity,storage,settingsstorage,userdataencryptbackup
# Xiaomi maps /cache to the rescue partition; wiping Cache destroys rescue data.
/dev/block/by-name/rescue /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable

# Only the host controller paired with dash's proven 16701000.usb0 path is kept.
/devices/platform/soc/16701000.usb0/16700000.xhci* auto auto defaults voldmanaged=usbotg:auto,storage,removable,storagename=USB-OTG

/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/init_boot /init_boot emmc defaults slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect
/dev/block/by-name/vbmeta /vbmeta emmc defaults slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults slotselect
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults slotselect
